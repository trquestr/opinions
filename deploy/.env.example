# Скопируйте в deploy/.env (он в .gitignore) и заполните. Compose читает его автоматически рядом с compose-файлом.

# --- Обязательно ---
# Домен, на который указывает A/AAAA-запись VPS; Caddy сам выпустит сертификат.
DOMAIN=example.com
# ОБЯЗАТЕЛЬНО смените пароль (длинный случайный, например `openssl rand -hex 24`).
POSTGRES_DB=untesis
POSTGRES_USER=untesis
POSTGRES_PASSWORD=change-me
# Хост - имя сервиса `postgres`. Пароль должен совпадать с POSTGRES_PASSWORD (спецсимволы - URL-кодировать).
DATABASE_URL=postgres://untesis:change-me@postgres:5432/untesis
# Единственный origin, которому разрешён CORS. Должен совпадать с https://<DOMAIN>.
WEB_ORIGIN=https://example.com
# Публичный адрес сайта. ВШИВАЕТСЯ В БАНДЛ при сборке образа web: после смены нужна пересборка (--build).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Можно оставить по умолчанию ---
REDIS_URL=redis://redis:6379
# Адрес api изнутри сети для серверного рендера Next.
API_INTERNAL_URL=http://api:4000
NODE_ENV=production
# Rate limit: не более THROTTLE_LIMIT запросов за THROTTLE_TTL_MS с одного клиента.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Максимум соединений api с Postgres (1..100).
DB_POOL_MAX=10

# --- Образы (если тянете из реестра вместо сборки на сервере) ---
# REGISTRY=ghcr.io/owner
# TAG=latest
