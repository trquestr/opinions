# Единая точка входа: HTTPS (Let's Encrypt автоматически) и маршрутизация /api/* -> Nest, остальное -> Next.
{$DOMAIN} {
	encode zstd gzip
	header -Server

	handle /api/* {
		reverse_proxy api:4000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}
