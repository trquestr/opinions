# Скопируйте в .env (он в .gitignore). Значения ниже рассчитаны на docker-compose.yml из корня репозитория.
NODE_ENV=development
PORT=4000
# Единственный origin, которому разрешён CORS (без «*»).
WEB_ORIGIN=http://localhost:3000
# Rate limit: не более THROTTLE_LIMIT запросов за THROTTLE_TTL_MS с одного клиента.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Postgres (протокол postgres:// или postgresql://). В проде — отдельный пользователь с минимальными правами.
DATABASE_URL=postgres://opinions:opinions@localhost:5432/opinions
# Максимум соединений в пуле (1..100).
DB_POOL_MAX=10
# Redis (redis:// или rediss:// для TLS).
REDIS_URL=redis://localhost:6379
# json | pretty. Если пусто: json в production, pretty иначе.
# LOG_FORMAT=pretty
